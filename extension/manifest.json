{
  "manifest_version": 3,
  "name": "ArtikelFinder",
  "version": "0.1.1",
  "description": "Shows der, die or das for a selected German noun, including inflected forms, with the source of every answer.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "options_ui": { "page": "about.html", "open_in_tab": true },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "lookup-selection": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Look up the article of the selected word"
    }
  }
}
